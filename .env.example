# Optional variable names for a future bundled deployment. The static app currently reads the
# Supabase project URL and public key from Settings → Account and saves them in this browser.
# Never put a service-role or secret key in a browser app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
